# Copy to .env and adjust. Every value below is optional — the defaults just work.

# SQLite (default, zero setup). To use MySQL instead:
#   DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/resume_db
DATABASE_URL=sqlite:///./storage/talentrank.db

# Firebase Authentication. Download this from your Firebase project:
#   Project settings > Service accounts > Generate new private key
# Save the downloaded JSON here (or point this at wherever you saved it).
# This file is a secret — it's gitignored, never commit it.
FIREBASE_CREDENTIALS_FILE=./firebase-service-account.json

# Alternative to the file above, for hosts that can set env vars but can't
# provision a secret file (e.g. Render — see render.yaml): the same JSON's
# raw content, on one line. Takes priority over the file when set.
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# Where uploaded resumes are stored
STORAGE_DIR=./storage/resumes

# Sentence-transformers model. Downloaded once on first use (~90MB).
# Set EMBEDDINGS_ENABLED=false to force the TF-IDF fallback (fully offline).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDINGS_ENABLED=true

# Comma-separated CORS origins for the Vite dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
