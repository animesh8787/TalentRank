# Copy to .env and adjust. Every value below is optional — the defaults just work.

# SQLite (default, zero setup). To use MySQL instead:
#   DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/resume_db
DATABASE_URL=sqlite:///./storage/talentrank.db

# Signing key for auth tokens. CHANGE THIS before exposing the app to a network.
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Where uploaded resumes are stored
STORAGE_DIR=./storage/resumes

# Sentence-transformers model. Downloaded once on first use (~90MB).
# Set EMBEDDINGS_ENABLED=false to force the TF-IDF fallback (fully offline).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDINGS_ENABLED=true

# Comma-separated CORS origins for the Vite dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
