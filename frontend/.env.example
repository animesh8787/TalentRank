# Copy to .env.local for local dev (Vite loads .env.local automatically and
# it's gitignored). On Vercel, set these as project environment variables
# instead — see README > Live deployment.

# Backend base URL. Leave unset locally — Vite's dev proxy handles /api.
# Required in production, once the backend is deployed:
# VITE_API_URL=https://talentrank-api.onrender.com

# Firebase web app config — from the Firebase console:
#   Project settings > General > Your apps > Web app
# These are public values, safe to ship in the frontend bundle. The private
# service-account key lives on the backend only (backend/.env.example).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
